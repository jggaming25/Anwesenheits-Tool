rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===================== Users =====================
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // ===================== Groups =====================
    match /groups/{groupId} {
      // Jeder authentifizierte User kann Gruppen lesen, in dem er Member ist
      allow read: if request.auth != null
        && (resource.data.members.hasAny([request.auth.uid])
            || resource.data.ownerUid == request.auth.uid);

      // Gruppe erstellen: nur eingeloggte User
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      // Gruppe bearbeiten: Owner oder Member (fuer Status-Updates, etc.)
      allow update: if request.auth != null
        && (resource.data.members.hasAny([request.auth.uid])
            || resource.data.ownerUid == request.auth.uid);

      // Nur Owner darf Gruppe loeschen
      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;

      // ===================== Logs (Subcollection) =====================
      match /logs/{logId} {
        // Logs lesen: nur Owner der Gruppe
        allow read: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid;

        // Logs schreiben: jeder Member der Gruppe
        allow create: if request.auth != null
          && (get(/databases/$(database)/documents/groups/$(groupId)).data.members.hasAny([request.auth.uid])
              || get(/databases/$(database)/documents/groups/$(groupId)).data.ownerUid == request.auth.uid);

        // Logs duerfen nicht bearbeitet werden
        allow update: if false;

        // Nur Cloud Functions duerfen alte Logs loeschen
        allow delete: if false;
      }
    }

    // ===================== Invites =====================
    match /invites/{email} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // ===================== Email Verifications =====================
    match /emailVerifications/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ===================== Email Change Requests =====================
    match /emailChangeRequests/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
